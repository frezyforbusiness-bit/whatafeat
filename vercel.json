{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install --no-audit --no-fund",
  "regions": ["fra1"],
  "build": {
    "env": {
      "DOCKER_BUILD": "0"
    }
  },
  "crons": [
    {
      "path": "/api/stripe/reconcile",
      "schedule": "0 3 * * *"
    }
  ]
}