# Whatafeat Prod 1.0 / local

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode: browser localStorage prototype (no DB/auth required)
# Set to 0 in production once Neon + Auth + Blob are configured
NEXT_PUBLIC_DEMO=1

# Paid activation (Phase 3). Leave unset/0 for Prod 1.0
# PAYMENTS_ENABLED=0
# NEXT_PUBLIC_PAYMENTS_ENABLED=0

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth.js (NextAuth v5)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_URL is inferred from NEXT_PUBLIC_APP_URL on Vercel; set locally if needed
# AUTH_URL=http://localhost:3000

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
