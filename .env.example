# Whatafeat Prod 1.0 / local

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode: browser localStorage prototype (no DB/auth required)
# Set to 0 in production once Neon + Auth + Blob are configured
NEXT_PUBLIC_DEMO=1

# Paid activation (Phase 3, Stripe). Leave unset/0 until the provider is wired.
# Server-side only: the client reads this via the bootstrap, so there is no
# NEXT_PUBLIC twin to keep in sync.
# PAYMENTS_ENABLED=0

# Stripe Connect (Phase 3). Payments stay off unless BOTH keys and
# PAYMENTS_ENABLED=1 are present.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Platform commission in basis points, withheld from the payout (250 = 2.5%)
# PLATFORM_FEE_BPS=0
# Optional: protect /api/stripe/reconcile (Authorization: Bearer …)
# CRON_SECRET=

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth.js (NextAuth v5)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_URL is inferred from NEXT_PUBLIC_APP_URL on Vercel; set locally if needed
# AUTH_URL=http://localhost:3000

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
