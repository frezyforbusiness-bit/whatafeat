# Whatafeat Prod 1.0 / local
# Full Production checklist: docs/GO_LIVE.md
# Schema: npm run db:migrate only (never db:push against Production Neon)

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode: browser localStorage prototype (no DB/auth required)
# Production Trade soft launch: set to 0 after Neon + Auth + Blob are configured
# See docs/GO_LIVE.md (migrate through 0003, then smoke with two Google accounts)
NEXT_PUBLIC_DEMO=1

# Paid activation. Leave unset/0 until Stripe test matrix is green
# (docs/STRIPE_TEST_MATRIX.md) and you follow docs/PAID_LIVE_RUNBOOK.md.
# Server-side only: the client reads this via the bootstrap.
# PAYMENTS_ENABLED=0

# Stripe Connect. Payments stay off unless BOTH keys and PAYMENTS_ENABLED=1.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PLATFORM_FEE_BPS=250
# CRON_SECRET=

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth.js (NextAuth v5)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_URL=http://localhost:3000

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Error monitoring (optional until soft launch hardening)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=   # upload source maps in CI only if configured

# Rate limiting (optional; requests pass through when unset)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
